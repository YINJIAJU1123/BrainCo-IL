                <mxCell id="rtc_policy_infer" value="&lt;b&gt;RTC guided sampling&lt;/b&gt;&lt;br&gt;latency = d control steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ABF5D1;strokeColor=#00875A;strokeWidth=2;fontColor=#006644;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="1815" y="1315" width="320" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="rtc_policy_ready" value="A&lt;sub&gt;new&lt;/sub&gt; ready&lt;br&gt;align + atomic swap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#79F2C0;strokeColor=#00875A;strokeWidth=2;fontColor=#006644;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="2170" y="1315" width="195" height="75" as="geometry"/>
