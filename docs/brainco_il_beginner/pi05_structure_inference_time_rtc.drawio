                <mxCell id="action_out_proj" value="&lt;b&gt;action_out_proj&lt;/b&gt;&lt;br&gt;Linear(1024, D)&lt;br&gt;output projection / action head" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1635" y="730" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="velocity" value="&lt;b&gt;Predicted flow velocity v&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;action-space output&lt;br&gt;&lt;font color=&quot;#006644&quot;&gt;[B, H, D]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ABF5D1;strokeColor=#00875A;strokeWidth=2;fontColor=#006644;fontSize=15;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1635" y="865" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="euler" value="&lt;b&gt;Vanilla Euler sampler (RTC OFF)&lt;/b&gt;&lt;br&gt;A&lt;sup&gt;τ+Δτ&lt;/sup&gt; = A&lt;sup&gt;τ&lt;/sup&gt; + Δτ · v&lt;sub&gt;π&lt;/sub&gt;&lt;br&gt;repeat → independent action chunk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#7A869A;strokeWidth=1.5;dashed=1;fontColor=#344563;fontSize=13;spacing=7;" parent="1" vertex="1">
                    <mxGeometry x="1615" y="200" width="240" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="training_note" value="&lt;b&gt;Training target&lt;/b&gt;&lt;br&gt;u&lt;sub&gt;t&lt;/sub&gt; = ε − action&lt;br&gt;MSE(v&lt;sub&gt;t&lt;/sub&gt;, u&lt;sub&gt;t&lt;/sub&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A869A;dashed=1;fontColor=#344563;fontSize=13;spacing=7;" parent="1" vertex="1">
                    <mxGeometry x="1635" y="485" width="200" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="rtc_zone" value="&lt;b&gt;5 · Inference-Time RTC runtime (added outside π0.5)&lt;/b&gt;" style="swimlane;html=1;rounded=1;horizontal=1;startSize=38;fillColor=#E3FCEF;swimlaneFillColor=#FFFFFF;strokeColor=#00875A;strokeWidth=2;fontColor=#006644;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="1910" y="110" width="930" height="1050" as="geometry"/>
                </mxCell>
                <mxCell id="rtc_inputs" value="&lt;b&gt;RTC runtime inputs&lt;/b&gt;&lt;br&gt;current observation o&lt;sub&gt;k&lt;/sub&gt;&lt;br&gt;aligned previous chunk A&lt;sub&gt;prev&lt;/sub&gt;&lt;br&gt;observed / conservative delay d&lt;br&gt;execution horizon s, chunk horizon H" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00875A;strokeWidth=2;fontColor=#006644;fontSize=13;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1940" y="165" width="260" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="rtc_mask" value="&lt;b&gt;Prefix-consistency mask W&lt;/b&gt;&lt;br&gt;W&lt;sub&gt;i&lt;/sub&gt; = 1　　　　　　　　　　 i &amp;lt; d　(frozen / committed)&lt;br&gt;W&lt;sub&gt;i&lt;/sub&gt; = decay(1 → 0)　 d ≤ i &amp;lt; H − s　(soft overlap)&lt;br&gt;W&lt;sub&gt;i&lt;/sub&gt; = 0　　　　　　　　　　 i ≥ H − s　(free suffix)&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;overlap length = H − s；常用 exponential decay；d ≤ s ≤ H − d&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;fontSize=13;spacing=8;align=left;" parent="1" vertex="1">
                    <mxGeometry x="2230" y="165" width="580" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="rtc_endpoint" value="&lt;b&gt;① Predict the clean endpoint&lt;/b&gt;&lt;br&gt;Â&lt;sup&gt;1&lt;/sup&gt; = A&lt;sup&gt;τ&lt;/sup&gt; + (1 − τ) · v&lt;sub&gt;π&lt;/sub&gt;(A&lt;sup&gt;τ&lt;/sup&gt;, o&lt;sub&gt;k&lt;/sub&gt;, τ)&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;当前 flow step 对最终 action chunk 的估计&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#00875A;strokeWidth=2;fontColor=#006644;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1940" y="390" width="390" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="rtc_guidance" value="&lt;b&gt;② Prefix error + vector–Jacobian product&lt;/b&gt;&lt;br&gt;e = (A&lt;sub&gt;prev&lt;/sub&gt; − Â&lt;sup&gt;1&lt;/sup&gt;)&lt;sup&gt;T&lt;/sup&gt; diag(W)&lt;br&gt;g = e · ∂Â&lt;sup&gt;1&lt;/sup&gt; / ∂A&lt;sup&gt;τ&lt;/sup&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;autodiff backward：让生成结果贴合旧 chunk 前缀&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#00875A;strokeWidth=2;fontColor=#006644;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1940" y="545" width="390" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="rtc_update" value="&lt;b&gt;③ Guided flow / Euler update&lt;/b&gt;&lt;br&gt;A&lt;sup&gt;τ+Δτ&lt;/sup&gt; = A&lt;sup&gt;τ&lt;/sup&gt; + Δτ [v&lt;sub&gt;π&lt;/sub&gt; + λ&lt;sub&gt;τ&lt;/sub&gt; g]&lt;br&gt;λ&lt;sub&gt;τ&lt;/sub&gt; = min(β, (1 − τ)/(τ r&lt;sub&gt;τ&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt;))&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;β clips guidance；每个 flow step 重复 ①→③&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ABF5D1;strokeColor=#00875A;strokeWidth=2.5;fontColor=#006644;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1940" y="725" width="390" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="rtc_new_chunk" value="&lt;b&gt;Guided chunk A&lt;sub&gt;new&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;hard prefix + softly consistent overlap + free suffix&lt;br&gt;&lt;font color=&quot;#006644&quot;&gt;[B, H, D]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#79F2C0;strokeColor=#00875A;strokeWidth=2.5;fontColor=#006644;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1965" y="940" width="340" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="rtc_async_queue" value="&lt;b&gt;Asynchronous Action Queue&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Control thread&lt;/b&gt;: continuously pop / execute A&lt;sub&gt;prev&lt;/sub&gt;&lt;br&gt;&lt;b&gt;Inference thread&lt;/b&gt;: capture o&lt;sub&gt;k&lt;/sub&gt;, copy leftovers, run guided sampling&lt;br&gt;&lt;b&gt;On completion&lt;/b&gt;: measure actual d, align indices, atomically swap A&lt;sub&gt;new&lt;/sub&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#BF2600&quot;&gt;关键：推理期间机器人不停止&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00A3BF;strokeWidth=2.5;fontColor=#0747A6;fontSize=14;spacing=9;" parent="1" vertex="1">
                    <mxGeometry x="2410" y="390" width="360" height="235" as="geometry"/>
                </mxCell>
                <mxCell id="rtc_controller" value="&lt;b&gt;Robot control loop @ fixed frequency&lt;/b&gt;&lt;br&gt;a ← queue.pop_left()&lt;br&gt;robot.send_action(a)&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;queue threshold / execution horizon triggers next request&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#00A3BF;strokeWidth=2;fontColor=#0747A6;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="2410" y="700" width="360" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="rtc_robot" value="&lt;b&gt;Robot + cameras&lt;/b&gt;&lt;br&gt;execute one action; stream next observation&lt;br&gt;&lt;font color=&quot;#006644&quot;&gt;continuous motion, no inference idle frame&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="2450" y="910" width="280" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="rtc_bootstrap" value="&lt;b&gt;Bootstrap / fallback&lt;/b&gt;&lt;br&gt;首个 chunk 没有 A&lt;sub&gt;prev&lt;/sub&gt;：先 vanilla sample 填充 queue；若新结果超时，继续消费旧 chunk，不能让队列耗尽。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0B3;strokeColor=#FFAB00;strokeWidth=1.5;fontColor=#7A3E00;fontSize=12;spacing=7;" parent="1" vertex="1">
                    <mxGeometry x="2400" y="1040" width="380" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="timeline_zone" value="&lt;b&gt;6 · Runtime timing — original synchronous rollout vs. inference-time RTC&lt;/b&gt;" style="swimlane;html=1;rounded=1;horizontal=1;startSize=40;fillColor=#F7F8F9;swimlaneFillColor=#FFFFFF;strokeColor=#6554C0;strokeWidth=2;fontColor=#403294;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1210" width="2800" height="545" as="geometry"/>
                </mxCell>
                <mxCell id="sync_title" value="&lt;b&gt;Original π0.5 · synchronous chunk rollout&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#344563;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1270" width="560" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="sync_observe" value="observe o&lt;sub&gt;k&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontColor=#0747A6;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="90" y="1335" width="150" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sync_infer" value="&lt;b&gt;vanilla flow sampling&lt;/b&gt;&lt;br&gt;robot waits during inference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;strokeWidth=2;fontColor=#BF2600;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="285" y="1325" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sync_execute" value="&lt;b&gt;execute first s actions&lt;/b&gt;&lt;br&gt;A&lt;sub&gt;k&lt;/sub&gt;[0 : s]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="580" y="1325" width="260" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sync_next_obs" value="observe o&lt;sub&gt;k+s&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontColor=#0747A6;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="885" y="1335" width="165" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sync_infer2" value="&lt;b&gt;infer next chunk&lt;/b&gt;&lt;br&gt;robot waits again" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;strokeWidth=2;fontColor=#BF2600;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="1095" y="1325" width="225" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sync_note" value="&lt;b&gt;结果&lt;/b&gt;：每个 chunk 边界都有 idle pause；新观测只能在当前执行窗口结束后触发推理，反应延迟约为 execution horizon + inference latency。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#B3BAC5;fontColor=#344563;fontSize=13;spacing=8;align=left;" parent="1" vertex="1">
                    <mxGeometry x="90" y="1460" width="1230" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="rtc_time_title" value="&lt;b&gt;Inference-time RTC · two concurrent loops&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#006644;" parent="1" vertex="1">
                    <mxGeometry x="1430" y="1270" width="560" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="rtc_policy_lane" value="&lt;b&gt;Inference thread&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#0747A6;" parent="1" vertex="1">
                    <mxGeometry x="1430" y="1325" width="145" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="rtc_policy_obs" value="capture o&lt;sub&gt;k&lt;/sub&gt;&lt;br&gt;+ A&lt;sub&gt;prev&lt;/sub&gt; leftovers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontColor=#0747A6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1600" y="1315" width="180" height="75" as="geometry"/>
