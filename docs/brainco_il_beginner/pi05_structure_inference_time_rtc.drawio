                <mxCell id="rtc_control_lane" value="&lt;b&gt;Control thread&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#0747A6;" parent="1" vertex="1">
                    <mxGeometry x="1430" y="1435" width="145" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="rtc_control_committed" value="&lt;b&gt;continue A&lt;sub&gt;prev&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;d committed actions execute while inference runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0B3;strokeColor=#FFAB00;strokeWidth=2;fontColor=#7A3E00;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1600" y="1425" width="535" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="rtc_control_swap" value="&lt;b&gt;switch to A&lt;sub&gt;new&lt;/sub&gt; suffix&lt;/b&gt;&lt;br&gt;continuous execution; next request starts before exhaustion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="2170" y="1425" width="560" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="rtc_time_note" value="&lt;b&gt;结果&lt;/b&gt;：没有等待帧；新 chunk 的前 d 步与执行事实一致，中间 overlap 软保持旧策略，后缀响应 o&lt;sub&gt;k&lt;/sub&gt;。注意：原始 RTC 仍以推理开始时的 o&lt;sub&gt;k&lt;/sub&gt; 为条件，并未消除 observation staleness。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontColor=#006644;fontSize=13;spacing=8;align=left;" parent="1" vertex="1">
