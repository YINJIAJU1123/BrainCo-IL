                <mxCell id="vlln" value="&lt;b&gt;VLLN / optional VL self-attention&lt;/b&gt;&lt;br&gt;LayerNorm; current default extra VL-SA = Identity&lt;br&gt;&lt;font color=&quot;#0747A6&quot;&gt;still [1, S, 2048]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F2FF;strokeColor=#4C9AFF;strokeWidth=1.5;fontColor=#0747A6;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="455" y="705" width="295" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="vlm_note" value="&lt;b&gt;N1.7 default tuning&lt;/b&gt;&lt;br&gt;visual + LLM backbone frozen&lt;br&gt;action head/projectors trainable&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;can be changed by fine-tuning config&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A869A;dashed=1;fontColor=#344563;fontSize=13;spacing=7;" parent="1" vertex="1">
                    <mxGeometry x="470" y="880" width="265" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="state_encoder" value="&lt;b&gt;Embodiment-specific State Encoder&lt;/b&gt;&lt;br&gt;CategorySpecificMLP&lt;br&gt;&lt;font color=&quot;#7A3E00&quot;&gt;[1,1,132] → 1024 → 1536&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E0;strokeColor=#FF991F;strokeWidth=2;fontColor=#7A3E00;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="945" y="470" width="230" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="state_token" value="&lt;b&gt;One state token&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7A3E00&quot;&gt;[1, 1, 1536]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8CC;strokeColor=#FF991F;strokeWidth=1.5;fontColor=#7A3E00;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="1210" y="485" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="flow_construct" value="&lt;b&gt;Flow-matching training sample&lt;/b&gt;&lt;br&gt;x&lt;sub&gt;t&lt;/sub&gt;=(1−t)ε+t·a · u&lt;sub&gt;t&lt;/sub&gt;=a−ε&lt;br&gt;&lt;font color=&quot;#7A3E00&quot;&gt;x&lt;sub&gt;t&lt;/sub&gt;,u&lt;sub&gt;t&lt;/sub&gt;: [1,40,132]&lt;/font&gt;&lt;br&gt;mask valid region [:,0:16,0:56]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#FF991F;strokeWidth=2;fontColor=#7A3E00;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="945" y="725" width="230" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="action_encoder" value="&lt;b&gt;Embodiment-specific Action Encoder&lt;/b&gt;&lt;br&gt;[1,40,132] → [1,40,1536]&lt;br&gt;+ sinusoidal t embedding → MLP&lt;br&gt;+ learned action-position embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E0;strokeColor=#FF991F;strokeWidth=2;fontColor=#7A3E00;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1210" y="720" width="235" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="action_tokens" value="&lt;b&gt;Noisy action tokens&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7A3E00&quot;&gt;[1, 40, 1536]&lt;/font&gt;&lt;br&gt;16 valid + 24 padded steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8CC;strokeColor=#FF991F;strokeWidth=1.5;fontColor=#7A3E00;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="1480" y="745" width="170" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="concat_sa" value="&lt;b&gt;Concatenate state + action tokens&lt;/b&gt;&lt;br&gt;DiT query stream&lt;br&gt;&lt;font color=&quot;#7A3E00&quot;&gt;[1, 1+40, 1536] = [1,41,1536]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD59A;strokeColor=#FF8B00;strokeWidth=2;fontColor=#7A3E00;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1400" y="555" width="225" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="dit_container" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F2;strokeColor=#FF8B00;strokeWidth=2.5;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="165" width="790" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="dit_title" value="&lt;b&gt;AlternateVLDiT · 16 Transformer blocks · hidden width 32 heads × 48 = 1536&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#7A3E00;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="175" width="710" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="cross_attn" value="&lt;b&gt;Even blocks: Cross-Attention&lt;/b&gt;&lt;br&gt;Q = state/action stream [1536]&lt;br&gt;K/V = VLM features [2048]&lt;br&gt;alternate non-image(text) / image masks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;strokeWidth=2;fontColor=#403294;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1030" y="235" width="245" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="self_attn" value="&lt;b&gt;Odd blocks: Self-Attention&lt;/b&gt;&lt;br&gt;state token ↔ all action tokens&lt;br&gt;temporal/action interaction&lt;br&gt;&lt;font color=&quot;#7A3E00&quot;&gt;residual + GEGLU FFN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8CC;strokeColor=#FF991F;strokeWidth=2;fontColor=#7A3E00;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1310" y="235" width="220" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="ada_norm" value="&lt;b&gt;Timestep encoder → AdaLayerNorm&lt;/b&gt;&lt;br&gt;256-D sin/cos → 1536-D t embedding&lt;br&gt;per-block scale(t), shift(t)&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;not PI0.5 adaRMS gate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E0;strokeColor=#FF991F;strokeWidth=2;fontColor=#7A3E00;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1560" y="225" width="205" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="dit_loop_note" value="Block order: cross(text) → self → cross(image) → self → …; VLM is condition memory, not a jointly updated action expert." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#5E6C84;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="385" width="610" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="dit_output" value="&lt;b&gt;DiT output projection&lt;/b&gt;&lt;br&gt;1536 → 1024&lt;br&gt;&lt;font color=&quot;#7A3E00&quot;&gt;[1, 41, 1024]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD59A;strokeColor=#FF8B00;strokeWidth=2;fontColor=#7A3E00;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1405" y="900" width="210" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="action_decoder" value="&lt;b&gt;Embodiment-specific Action Decoder&lt;/b&gt;&lt;br&gt;[1,41,1024] → [1,41,132]&lt;br&gt;slice last 40 positions&lt;br&gt;&lt;font color=&quot;#7A3E00&quot;&gt;velocity [1,40,132]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E0;strokeColor=#FF991F;strokeWidth=2;fontColor=#7A3E00;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1165" y="935" width="220" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="pred_velocity" value="&lt;b&gt;Predicted flow velocity v&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#006644&quot;&gt;[1, 40, 132]&lt;/font&gt;&lt;br&gt;action_mask [1,40,132]&lt;br&gt;valid [:,0:16,0:56]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="930" y="945" width="205" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="loss" value="&lt;b&gt;Training supervision&lt;/b&gt;&lt;br&gt;masked MSE(v&lt;sub&gt;t&lt;/sub&gt;, a−ε)&lt;br&gt;backprop through action head&lt;br&gt;and any unfrozen backbone parameters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;strokeWidth=1.5;fontColor=#BF2600;fontSize=13;spacing=7;" parent="1" vertex="1">
                    <mxGeometry x="1585" y="920" width="210" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="euler" value="&lt;b&gt;4-step Euler integration&lt;/b&gt;&lt;br&gt;x ← x + Δt · v&lt;sub&gt;t&lt;/sub&gt;&lt;br&gt;Δt = +1/4&lt;br&gt;&lt;font color=&quot;#006644&quot;&gt;t: 0 noise → 1 action&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1900" y="695" width="225" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="action_chunk" value="&lt;b&gt;Internal denoised action tensor&lt;/b&gt;&lt;br&gt;before embodiment slicing&lt;br&gt;&lt;font color=&quot;#006644&quot;&gt;[1, 40, 132]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ABF5D1;strokeColor=#00875A;strokeWidth=2;fontColor=#006644;fontSize=15;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1900" y="870" width="225" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="postprocess" value="&lt;b&gt;Slice + unnormalize&lt;/b&gt;&lt;br&gt;keep horizon 0:16 and dimensions 0:56&lt;br&gt;&lt;font color=&quot;#006644&quot;&gt;final action [1, 16, 56]&lt;/font&gt;&lt;br&gt;split named streams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=1.5;fontColor=#006644;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1900" y="1010" width="225" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="controller" value="&lt;b&gt;Robot controller&lt;/b&gt;&lt;br&gt;execute first K steps, then re-plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=1.5;fontColor=#006644;fontSize=14;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="1900" y="535" width="225" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="comparison_zone" value="&lt;b&gt;GR00T N1.7 vs PI0.5 — the important architectural differences&lt;/b&gt;" style="swimlane;html=1;rounded=1;horizontal=1;startSize=40;fillColor=#F4F5F7;swimlaneFillColor=#FFFFFF;strokeColor=#6554C0;strokeWidth=2;fontColor=#403294;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="30" y="1150" width="2135" height="245" as="geometry"/>
                </mxCell>
                <mxCell id="compare_coupling" value="&lt;b&gt;Coupling&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7A3E00&quot;&gt;GR00T:&lt;/font&gt; VLM first, separate DiT reads VLM memory by cross-attention.&lt;br&gt;&lt;font color=&quot;#0747A6&quot;&gt;PI0.5:&lt;/font&gt; Prefix/Action experts are paired inside every one of 18 layers and concatenate Q/K/V for joint attention." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6554C0;fontColor=#344563;fontSize=13;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="55" y="1210" width="400" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="compare_state" value="&lt;b&gt;Robot state&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7A3E00&quot;&gt;GR00T:&lt;/font&gt; continuous state → embodiment-specific MLP → one 1536-D DiT token.&lt;br&gt;&lt;font color=&quot;#0747A6&quot;&gt;PI0.5:&lt;/font&gt; state values are discretized into text tokens and placed in the 2048-D VLM prefix." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6554C0;fontColor=#344563;fontSize=13;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="475" y="1210" width="400" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="compare_action" value="&lt;b&gt;Action network&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7A3E00&quot;&gt;GR00T:&lt;/font&gt; independent 16-block DiT, width 1536; alternate cross/self-attention; embodiment-specific encoder/decoder.&lt;br&gt;&lt;font color=&quot;#0747A6&quot;&gt;PI0.5:&lt;/font&gt; Gemma 300M Action Expert, width 1024, coupled to Gemma 2B Prefix Expert." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6554C0;fontColor=#344563;fontSize=13;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="895" y="1210" width="400" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="compare_time" value="&lt;b&gt;Flow convention / time conditioning&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7A3E00&quot;&gt;GR00T:&lt;/font&gt; t=0 noise → t=1 action; target a−ε; AdaLayerNorm scale/shift; +dt.&lt;br&gt;&lt;font color=&quot;#0747A6&quot;&gt;PI0.5 code:&lt;/font&gt; t=1 noise → t=0 action; target ε−a; adaRMS scale/shift/gate; −dt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6554C0;fontColor=#344563;fontSize=13;spacing=8;" parent="1" vertex="1">
