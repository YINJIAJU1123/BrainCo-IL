                <mxCell id="backbone" value="&lt;b&gt;Cosmos-Reason2-2B&lt;/b&gt;&lt;br&gt;Qwen3-VL architecture&lt;br&gt;System 2 visual-language reasoning&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;default select_layer = 12&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3D4FF;strokeColor=#0052CC;strokeWidth=2.5;fontColor=#0747A6;fontSize=16;spacing=9;" parent="1" vertex="1">
