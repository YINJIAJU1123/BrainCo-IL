                <mxCell id="actions_train" value="&lt;b&gt;Action chunk / inference noise&lt;/b&gt;&lt;br&gt;valid training action a [1, 16, 56]&lt;br&gt;pad horizon + dimensions&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;model tensor / ε [1, 40, 132]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#FF991F;strokeWidth=2;fontColor=#7A3E00;fontSize=14;spacing=8;" parent="1" vertex="1">
