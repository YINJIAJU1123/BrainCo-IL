                <mxCell id="backbone_features" value="&lt;b&gt;VLM backbone features&lt;/b&gt;&lt;br&gt;condition memory / hidden states&lt;br&gt;&lt;font color=&quot;#0747A6&quot;&gt;[1, S, 2048]&lt;/font&gt;&lt;br&gt;S is dynamic, not fixed 3×256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#4C9AFF;strokeWidth=2;fontColor=#0747A6;fontSize=15;spacing=8;" parent="1" vertex="1">
