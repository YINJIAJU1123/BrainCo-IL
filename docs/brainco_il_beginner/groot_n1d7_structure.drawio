                <mxCell id="flow_t" value="&lt;b&gt;Flow timestep t&lt;/b&gt;&lt;br&gt;continuous [1] → bucket [1]&lt;br&gt;&lt;font color=&quot;#006644&quot;&gt;t=0 noise → t=1 action&lt;/font&gt;&lt;br&gt;1000 discrete buckets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#FF991F;strokeWidth=1.5;fontColor=#7A3E00;fontSize=14;spacing=8;" parent="1" vertex="1">
