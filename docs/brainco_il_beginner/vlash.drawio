          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_switch_next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#36B37E;strokeWidth=2;" parent="r1" source="p2_switch" target="p2_next_actions" edge="1">
