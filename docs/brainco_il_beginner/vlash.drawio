  <diagram id="vlash-async-runtime" name="2 · VLASH Async Inference">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="r0"/>
        <mxCell id="r1" parent="r0"/>

        <mxCell id="p2_title" value="&lt;b&gt;VLASH Runtime — Execute Current Chunk While Inferring the Next Chunk&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=25;fontColor=#172B4D;" parent="r1" vertex="1">
          <mxGeometry x="260" y="20" width="1400" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="p2_subtitle" value="VLASH fixes prediction–execution temporal misalignment by replacing stale state s&lt;sub&gt;t&lt;/sub&gt; with estimated execution-time state ŝ&lt;sub&gt;t+Δ&lt;/sub&gt;; the visual observation remains o&lt;sub&gt;t&lt;/sub&gt;." style="text;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=14;fontColor=#5E6C84;" parent="r1" vertex="1">
          <mxGeometry x="280" y="68" width="1360" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="p2_sync_zone" value="&lt;b&gt;A · Synchronous PI0.5&lt;/b&gt;" style="swimlane;html=1;rounded=1;horizontal=1;startSize=38;fillColor=#F7F8F9;swimlaneFillColor=#FFFFFF;strokeColor=#7A869A;strokeWidth=1.5;fontColor=#344563;fontSize=15;" parent="r1" vertex="1">
          <mxGeometry x="35" y="120" width="570" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="p2_naive_zone" value="&lt;b&gt;B · Naive asynchronous&lt;/b&gt;" style="swimlane;html=1;rounded=1;horizontal=1;startSize=38;fillColor=#F7F8F9;swimlaneFillColor=#FFFFFF;strokeColor=#FF5630;strokeWidth=2;fontColor=#BF2600;fontSize=15;" parent="r1" vertex="1">
          <mxGeometry x="675" y="120" width="570" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="p2_vlash_zone" value="&lt;b&gt;C · VLASH asynchronous&lt;/b&gt;" style="swimlane;html=1;rounded=1;horizontal=1;startSize=38;fillColor=#F7F8F9;swimlaneFillColor=#FFFFFF;strokeColor=#6554C0;strokeWidth=2;fontColor=#403294;fontSize=15;" parent="r1" vertex="1">
          <mxGeometry x="1315" y="120" width="570" height="350" as="geometry"/>
        </mxCell>

        <mxCell id="p2_sync_obs" value="Capture (o&lt;sub&gt;t&lt;/sub&gt;, s&lt;sub&gt;t&lt;/sub&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F2FF;strokeColor=#4C9AFF;fontColor=#0747A6;fontSize=14;" parent="r1" vertex="1">
          <mxGeometry x="65" y="190" width="135" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p2_sync_infer" value="PI0.5 inference&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;robot waits Δ steps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;fontColor=#BF2600;fontSize=14;" parent="r1" vertex="1">
          <mxGeometry x="235" y="180" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2_sync_execute" value="Execute A&lt;sub&gt;t&lt;/sub&gt;&lt;br&gt;after inference finishes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontColor=#006644;fontSize=14;" parent="r1" vertex="1">
          <mxGeometry x="420" y="180" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2_sync_result" value="&lt;b&gt;Correct alignment, but action stall&lt;/b&gt;&lt;br&gt;reaction latency ≈ inference + execution wait" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A869A;fontColor=#344563;fontSize=14;spacing=8;" parent="r1" vertex="1">
          <mxGeometry x="125" y="320" width="390" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="p2_naive_obs" value="Capture (o&lt;sub&gt;t&lt;/sub&gt;, s&lt;sub&gt;t&lt;/sub&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F2FF;strokeColor=#4C9AFF;fontColor=#0747A6;fontSize=14;" parent="r1" vertex="1">
          <mxGeometry x="705" y="190" width="135" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p2_naive_parallel" value="Current chunk executes&lt;br&gt;∥ PI0.5 infers next chunk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#FF991F;fontColor=#7A3E00;fontSize=14;" parent="r1" vertex="1">
          <mxGeometry x="875" y="180" width="165" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2_naive_switch" value="At t+Δ switch to A′&lt;sub&gt;t&lt;/sub&gt;&lt;br&gt;predicted from stale s&lt;sub&gt;t&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;fontColor=#BF2600;fontSize=14;" parent="r1" vertex="1">
          <mxGeometry x="1075" y="180" width="145" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2_naive_result" value="&lt;b&gt;Fast, but misaligned&lt;/b&gt;&lt;br&gt;prediction interval [t,t+K) ≠ execution interval [t+Δ,t+Δ+K)&lt;br&gt;chunk boundary can jump / become unstable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;fontColor=#BF2600;fontSize=14;spacing=8;" parent="r1" vertex="1">
          <mxGeometry x="755" y="310" width="410" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="p2_vlash_obs" value="Capture current o&lt;sub&gt;t&lt;/sub&gt;&lt;br&gt;+ know remaining old actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F2FF;strokeColor=#4C9AFF;fontColor=#0747A6;fontSize=14;" parent="r1" vertex="1">
          <mxGeometry x="1345" y="180" width="145" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2_vlash_roll" value="Roll state forward&lt;br&gt;s&lt;sub&gt;t&lt;/sub&gt; → ŝ&lt;sub&gt;t+Δ&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#6554C0;strokeWidth=2;fontColor=#403294;fontSize=14;" parent="r1" vertex="1">
          <mxGeometry x="1520" y="180" width="145" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2_vlash_infer" value="PI0.5(o&lt;sub&gt;t&lt;/sub&gt;, ŝ&lt;sub&gt;t+Δ&lt;/sub&gt;)&lt;br&gt;while old chunk executes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#6554C0;strokeWidth=2;fontColor=#403294;fontSize=14;" parent="r1" vertex="1">
          <mxGeometry x="1695" y="180" width="155" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2_vlash_result" value="&lt;b&gt;Fast + aligned robot state&lt;/b&gt;&lt;br&gt;new chunk is planned for the state where it will actually start&lt;br&gt;future environment is not predicted; image remains stale o&lt;sub&gt;t&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;fontSize=14;spacing=8;" parent="r1" vertex="1">
          <mxGeometry x="1395" y="310" width="410" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="p2_runtime_zone" value="&lt;b&gt;Runtime timeline for one chunk transition&lt;/b&gt;" style="swimlane;html=1;rounded=1;horizontal=1;startSize=40;fillColor=#F7F8F9;swimlaneFillColor=#FFFFFF;strokeColor=#6554C0;strokeWidth=2;fontColor=#403294;fontSize=16;" parent="r1" vertex="1">
          <mxGeometry x="35" y="505" width="1850" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="p2_time_axis" value="controller time →" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#5E6C84;" parent="r1" vertex="1">
          <mxGeometry x="75" y="555" width="180" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p2_t0" value="t" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DEEBFF;strokeColor=#4C9AFF;fontColor=#0747A6;fontSize=14;" parent="r1" vertex="1">
          <mxGeometry x="275" y="550" width="42" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="p2_trigger" value="Trigger next inference&lt;br&gt;n_action_steps − overlap_steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#6554C0;fontColor=#403294;fontSize=13;" parent="r1" vertex="1">
          <mxGeometry x="340" y="535" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2_current_actions" value="Current chunk continues executing known remaining actions&lt;br&gt;a&lt;sub&gt;t&lt;/sub&gt;, a&lt;sub&gt;t+1&lt;/sub&gt;, …, a&lt;sub&gt;t+Δ−1&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#FF991F;strokeWidth=2;fontColor=#7A3E00;fontSize=14;" parent="r1" vertex="1">
          <mxGeometry x="340" y="635" width="500" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2_state_formula" value="&lt;b&gt;Estimate execution-time state&lt;/b&gt;&lt;br&gt;delta actions: ŝ&lt;sub&gt;t+Δ&lt;/sub&gt; = s&lt;sub&gt;t&lt;/sub&gt; + Σ&lt;sub&gt;i=0…Δ−1&lt;/sub&gt; a&lt;sub&gt;t+i&lt;/sub&gt;&lt;br&gt;absolute actions: use last scheduled action/state endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;fontSize=14;spacing=8;" parent="r1" vertex="1">
          <mxGeometry x="875" y="615" width="365" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p2_background_infer" value="&lt;b&gt;Background PI0.5 inference&lt;/b&gt;&lt;br&gt;condition: (o&lt;sub&gt;t&lt;/sub&gt;, ŝ&lt;sub&gt;t+Δ&lt;/sub&gt;)&lt;br&gt;prefix prefill + 10 Euler denoise steps&lt;br&gt;produces next chunk A′&lt;sub&gt;t+Δ&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#6554C0;strokeWidth=2;fontColor=#403294;fontSize=14;spacing=8;" parent="r1" vertex="1">
          <mxGeometry x="1275" y="600" width="310" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="p2_switch" value="t+Δ&lt;br&gt;atomic chunk switch&lt;br&gt;&lt;font color=&quot;#006644&quot;&gt;no idle stall&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;fontSize=13;" parent="r1" vertex="1">
          <mxGeometry x="1640" y="600" width="120" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p2_next_actions" value="Execute new chunk&lt;br&gt;A′&lt;sub&gt;t+Δ:t+Δ+K−1&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;fontSize=14;" parent="r1" vertex="1">
          <mxGeometry x="1620" y="770" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="p2_terms" value="&lt;b&gt;Symbols&lt;/b&gt;　H = predicted action horizon　K ≤ H = actions executed per chunk　Δ = inference latency in controller steps　overlap_steps = how early background inference starts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A869A;fontColor=#344563;fontSize=14;spacing=8;" parent="r1" vertex="1">
          <mxGeometry x="80" y="925" width="870" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="p2_quant" value="&lt;b&gt;Optional action quantization q&lt;/b&gt;　groups/resamples q adjacent fine actions into a coarser command (delta: accumulate; absolute: endpoint), reducing command count and increasing execution speed. It is a deployment option, not a Transformer change." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#FF991F;fontColor=#7A3E00;fontSize=14;spacing=8;" parent="r1" vertex="1">
          <mxGeometry x="985" y="925" width="835" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="p2_footer" value="Required VLASH runtime change = asynchronous chunk manager + future-state rollforward. No RTC-style action inpainting and no extra correction network are run at deployment." style="text;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=15;fontColor=#172B4D;" parent="r1" vertex="1">
          <mxGeometry x="330" y="1030" width="1260" height="42" as="geometry"/>
        </mxCell>

        <mxCell id="p2_e_sync_1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7A869A;strokeWidth=2;" parent="r1" source="p2_sync_obs" target="p2_sync_infer" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_sync_2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7A869A;strokeWidth=2;" parent="r1" source="p2_sync_infer" target="p2_sync_execute" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_naive_1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#FF5630;strokeWidth=2;" parent="r1" source="p2_naive_obs" target="p2_naive_parallel" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_naive_2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#FF5630;strokeWidth=2;" parent="r1" source="p2_naive_parallel" target="p2_naive_switch" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_vlash_1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6554C0;strokeWidth=2;" parent="r1" source="p2_vlash_obs" target="p2_vlash_roll" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_vlash_2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6554C0;strokeWidth=2;" parent="r1" source="p2_vlash_roll" target="p2_vlash_infer" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_trigger_actions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#FF991F;strokeWidth=2;" parent="r1" source="p2_trigger" target="p2_current_actions" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_actions_state" value="known actions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;" parent="r1" source="p2_current_actions" target="p2_state_formula" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2_e_state_infer" value="ŝ&lt;sub&gt;t+Δ&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6554C0;strokeWidth=2;fontColor=#403294;" parent="r1" source="p2_state_formula" target="p2_background_infer" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
